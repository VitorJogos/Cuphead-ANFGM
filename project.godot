;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Cuphead AFGM"
config/description="Cuphead Another Fangame"
config/version="0.6"
run/main_scene="uid://cptmkfcriwqtd"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="uid://eogx5r0m16gi"

[autoload]

gvar="*uid://cejlgmotp1p1u"
player="*uid://birn0pd047jve"
Tradutor="*res://Nova pasta/tradutor.gd"

[display]

window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="Cuphead AFGM"

[editor_plugins]

enabled=PackedStringArray("res://addons/virtual_joystick/plugin.cfg")

[file_customization]

folder_colors={
"res://Assets/": "orange",
"res://Audios/": "purple",
"res://Exports/": "gray",
"res://Fonts/": "green",
"res://Scenes/": "blue",
"res://Scripts/": "red",
"res://addons/": "yellow"
}

[global_group]

atiravel="algo q o tiro acerta mas nao da dano"
dano="algo que o jogador de dano"
"levar dano"="algo que o jogador leve dano"
parryavel="algo que o jogador consiga dar parry"
boss="Se o inimigo é um boss"
chao="um piso pro obus funcionar"
player=""

