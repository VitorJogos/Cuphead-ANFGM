[sub_resource type="Shader" id="Shader_8runj"]
code = "shader_type canvas_item;

uniform bool selecionado = true;
uniform sampler2D textura_vermelha : source_color, hint_default_black, filter_nearest, repeat_enable;

void fragment() {
    // Pega o formato da letra
    vec4 tex_color = texture(TEXTURE, UV);
    
    if (tex_color.a > 0.0) {
        if (selecionado) {
            // Cria um criador de repetição (tiling) para o papel não ficar esticado
            vec2 uv_loop = fract(UV * 2.0); 
            
            // O PULO DO GATO: Limitamos o X entre 0.03 e 0.20 (onde fica o vermelho)
            // E o Y entre 0.15 e 0.75 para fugir das bordas azuis do menu
            vec2 uv_so_vermelho = vec2(
                0.03 + (uv_loop.x * 0.17), 
                0.15 + (uv_loop.y * 0.60)
            );
            
            vec4 cor_papel = texture(textura_vermelha, uv_so_vermelho);
            COLOR = vec4(cor_papel.rgb, tex_color.a);
        } else {
            // Cor preta/cinza padrão do Cuphead quando não está selecionado
            COLOR = vec4(0.15, 0.15, 0.15, tex_color.a);
        }
    } else {
        COLOR = tex_color;
    }
}"

